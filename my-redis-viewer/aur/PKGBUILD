# Maintainer: Sebastián Gurin (cancerberoSgx) <sebastian@devaiq.com>

# VCS (-git) package: builds my-redis-viewer straight from this monorepo's
# main branch. There are no per-app release tags (yet), and Arch's own
# package manager already guarantees python/wxWidgets are on the target
# system, so there is nothing to bundle - unlike the PyInstaller builds in
# .github/workflows/my-redis-viewer-build.yml, which target non-Arch Linux
# (and Windows/macOS) and so vendor a private copy of everything. See
# /AUR.md at the repo root for the full local-test/publish workflow.

pkgname=my-redis-viewer-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="Native wxWidgets desktop app for managing and testing Redis connection profiles"
arch=('any')
url="https://github.com/cancerberoSgx/desktop-app-samples"
license=('MIT')
depends=('python' 'python-wxpython' 'python-redis')
makedepends=('git')
provides=('my-redis-viewer' 'myredisviewer')
conflicts=('my-redis-viewer' 'myredisviewer')
source=("$pkgname::git+https://github.com/cancerberoSgx/desktop-app-samples.git#branch=main")
sha256sums=('SKIP')

_pkgsubdir=my-redis-viewer
_bin=myredisviewer

pkgver() {
  cd "$pkgname"
  # Whole-repo commit count (not just this app's subtree) so the version
  # always increases even across history that touches other apps only.
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
  local _src="$srcdir/$pkgname/$_pkgsubdir"
  local _appdir="$pkgdir/usr/lib/$_bin"

  # Vendor main.py + app/ under /usr/lib/<bin>/, not into Python's shared
  # site-packages: every one of these apps has its own top-level `app`
  # package (see app/frame.py etc.) - installing them all as global `app`
  # modules would collide. The launcher script below points PYTHONPATH at
  # this private directory instead, same effect as a venv without the venv.
  # app/db/paths.py locates app/db/migrations relative to this directory's
  # own layout, so main.py and app/ must stay siblings exactly like this.
  install -d "$_appdir"
  cp "$_src/main.py" "$_appdir/main.py"
  cp -r "$_src/app" "$_appdir/app"
  find "$_appdir" -name '__pycache__' -type d -exec rm -rf {} +

  install -Dm755 "$_src/aur/$_bin.sh" "$pkgdir/usr/bin/$_bin"
  install -Dm644 "$_src/aur/$_bin.desktop" "$pkgdir/usr/share/applications/$_bin.desktop"
  install -Dm644 "$_src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
