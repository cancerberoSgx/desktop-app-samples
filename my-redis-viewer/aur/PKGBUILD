# Maintainer: Sebastián Gurin (cancerberoSgx) <sebastian@devaiq.com>

# Versioned package: builds my-redis-viewer from a tagged release
# (my-redis-viewer-v<pkgver>), not the rolling main branch - every app in this
# monorepo now uses this same versioned-package scheme (my-file-viewer is
# the only app with no AUR package at all - see /AUR.md at the repo root
# for why, and for the full local-test/publish workflow). Arch's own
# package manager already
# guarantees python/wxWidgets are on the target system, so there is
# nothing to bundle - unlike the PyInstaller builds in
# .github/workflows/my-redis-viewer-build.yml, which target non-Arch Linux
# (and Windows/macOS) and so vendor a private copy of everything.

pkgname=my-redis-viewer
pkgver=1.0.0
pkgrel=1
pkgdesc="Native wxWidgets desktop app for managing and testing Redis connection profiles"
arch=('any')
url="https://github.com/cancerberoSgx/desktop-app-samples"
license=('MIT')
depends=('python' 'python-wxpython' 'python-redis')
makedepends=('git')
provides=('myredisviewer')
conflicts=('my-redis-viewer-git' 'myredisviewer')
source=("$pkgname::git+https://github.com/cancerberoSgx/desktop-app-samples.git#tag=my-redis-viewer-v$pkgver")
sha256sums=('SKIP')

_pkgsubdir=my-redis-viewer
_bin=myredisviewer

package() {
  local _src="$srcdir/$pkgname/$_pkgsubdir"
  local _appdir="$pkgdir/usr/lib/$_bin"

  # Vendor main.py + app/ under /usr/lib/<bin>/, not into Python's shared
  # site-packages: every one of these apps has its own top-level `app`
  # package (see app/frame.py etc.) - installing them all as global `app`
  # modules would collide. The launcher script below points PYTHONPATH at
  # this private directory instead, same effect as a venv without the venv.
  # app/db/paths.py locates app/db/migrations (and, via app/version.py, the
  # VERSION file - what Help > About reads) relative to this directory's
  # own layout, so main.py, app/ and VERSION must stay siblings exactly
  # like this.
  install -d "$_appdir"
  cp "$_src/main.py" "$_appdir/main.py"
  cp "$_src/VERSION" "$_appdir/VERSION"
  cp -r "$_src/app" "$_appdir/app"
  find "$_appdir" -name '__pycache__' -type d -exec rm -rf {} +

  install -Dm755 "$_src/aur/$_bin.sh" "$pkgdir/usr/bin/$_bin"
  install -Dm644 "$_src/aur/$_bin.desktop" "$pkgdir/usr/share/applications/$_bin.desktop"
  install -Dm644 "$_src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
