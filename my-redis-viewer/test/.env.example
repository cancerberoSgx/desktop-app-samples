# Copy this file to .env (next to it, in this test/ folder) and adjust if
# your Redis instance isn't the default local docker-compose one.
#
# These are read by test/conftest.py. Any value left blank/unset falls back
# to the default shown here, which matches `docker compose up` in this
# folder and a fresh redis-stack container with no ACL configured.

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
